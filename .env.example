# ============================================================================
# Mess&Anger (Nova Dark Messenger) — environment template
# Copy this to `.env` and fill in fresh values. `.env` is gitignored.
# Never commit real values. For CI, use GitHub Actions Secrets instead.
# ============================================================================

# Android signing (scripts/deploy-android.ps1)
# There is exactly ONE keystore in this project: play-upload-key.jks in the repo
# root (alias messandanger). Google Play accepts no other key — never generate
# a replacement unless you complete an upload key reset in Play Console first.
# The gitignored keystore.properties points at the same key.
KEYSTORE_PATH="play-upload-key.jks"
KEYSTORE_PASSWORD="<play-upload-key.jks store password>"
KEY_ALIAS="messandanger"
KEY_PASSWORD="<play-upload-key.jks key password>"
# CI: use ANDROID_KEYSTORE_BASE64 + ANDROID_KEYSTORE_PASSWORD +
# ANDROID_KEY_ALIAS + ANDROID_KEY_PASSWORD (see docs/deploy-aab.md).

# PaymentO (store: "Mess&Anger user")
# Browser widget (landing/paymento.js) uses the public API key/URL.
# Server (server.js) uses PAYMENTO_SECRET for HMAC-SHA256 signature check.
PAYMENTO_API_URL="https://api.paymento.io"
# Public (front-side) key — shown in the browser widget
PAYMENTO_API_KEY="<paymento_public_api_key>"
# Secret (server-side) — never sent to the browser
PAYMENTO_SECRET_KEY="<paymento_secret_api_key>"
# Shared HMAC secret for the IPN endpoint (store settings "Mess&Anger user")
PAYMENTO_SECRET="<paymento_ipn_hmac_secret>"
# Optional: comma-separated extra secrets, all accepted by the IPN signature
# check (use when rotating the store secret). First entry wins.
PAYMENTO_SECRET_KEYS=""
# Optional: override the verify endpoint
PAYMENTO_VERIFY_URL=""
# Optional: HMAC secret for signing premium license keys (default: PAYMENTO_SECRET)
PREMIUM_LICENSE_SECRET=""
# Optional: PaymentO return URL after checkout
PAYMENTO_RETURN_URL=""
# Optional: premium order/license/gift storage dirs (default: ./orders, ./licenses, ./gifts)
ORDERS_DIR=""
LICENSES_DIR=""
GIFTS_DIR=""

# Cloudflare (optional — only if deploying via CF Pages/Workers)
CLOUDFLARE_ACCOUNT_ID="<cloudflare_account_id>"
CLOUDFLARE_API_TOKEN="<cloudflare_scoped_api_token>"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Drive Backup (drive.file scope - recommended, lower verification burden)
# Create OAuth client in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI must match VITE_GOOGLE_DRIVE_REDIRECT_URI
# Web: https://your-domain.com/auth/google-drive/callback
# Android: com.messanger.e2e:/auth/google-drive/callback (deep link)
# iOS: com.messanger.e2e:/auth/google-drive/callback (universal link)
VITE_GOOGLE_DRIVE_CLIENT_ID="<google_oauth_client_id>.apps.googleusercontent.com"
VITE_GOOGLE_DRIVE_REDIRECT_URI="https://your-domain.com/auth/google-drive/callback"

# Supabase (optional — for signaling relay + profiles)
# Get these from your Supabase project settings → API
VITE_SUPABASE_URL="https://<your-project>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-anon-key>"

# ───────────────────────────────────────────────────────────────────────────
# PaymentO (server-side IPN — see server.js)
# ───────────────────────────────────────────────────────────────────────────
# Shared secret from the PaymentO store settings ("Mess&Anger user" → IPN).
# Used to verify the HMAC-SHA256 signature on every IPN callback.
# Leave empty to disable IPN handling entirely: unsigned callbacks are always
# rejected, in development as well.
PAYMENTO_SECRET=""
# Optional: override the PaymentO verify endpoint (default: https://api.paymento.io/v2/verify)
PAYMENTO_VERIFY_URL=""
# Where to persist IPN receipts (one JSON per payment). Default: ./receipts
RECEIPTS_DIR=""
# Port for `node server.js` (default 8080)
PORT="8080"
# Comma-separated origins allowed to call the API from a browser. Defaults to
# the Tauri webviews and the local dev servers (3000, 1420). Add your landing
# origin here; requests from any other origin are refused.
CORS_ORIGINS=""

# ───────────────────────────────────────────────────────────────────────────
# Anonymous queue relay (server.js)
# SQLite file for queues so a process restart does not lose messages. On a VDS
# this is a normal file; in a container mount a persistent volume for it. Set
# empty to disable persistence and keep queues in memory only.
ANON_STATE_DB_PATH="./anon-state.sqlite"
# ───────────────────────────────────────────────────────────────────────────
# Public relay base URL baked into the client. Empty = local mode: invites and
# messages stay in this browser until the user enters a relay in Advanced
# network settings. Do NOT point this at the landing host unless server.js is
# actually serving /api/anon/* there (the static landing does not).
VITE_ANON_RELAY_URL=""
# Comma-separated independent relay hosts used as queues' standby. Put the
# second host on a different provider/region from VITE_ANON_RELAY_URL; a second
# URL on the same VDS does not survive that VDS going down. New invites and
# rotated queues get a standby queue automatically when this list is non-empty.
VITE_ANON_RELAY_FALLBACK_URLS=""
# WebSocket signaling for remote calls and the P2P transport. Empty = derive
# wss://<VITE_ANON_RELAY_URL host>/api/signaling from the relay URL above.
# Set explicitly only when signaling runs on a different host.
VITE_SIGNALING_URL=""
# TURN relay for calls that cannot connect directly (symmetric NAT, mobile
# networks). Comma-separated turn:/turns: URLs; username/credential are the
# coturn static-auth values. They are baked into the client, so use short-lived
# credentials or a dedicated TURN host, not long-lived shared secrets.
# Without TURN, Settings → Privacy → "WebRTC IP privacy" cannot be enabled
# safely: relay-only mode refuses to start when no TURN server is configured.
VITE_TURN_URLS=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
# 32-byte base64url X25519 private key used to open sealed proxy-hop envelopes.
# Generate once, keep secret, and pin the matching public key on clients.
# Empty = generate an ephemeral key at boot (development only).
ANON_ROUTING_PRIVATE_KEY=""
# Comma-separated proxy allowlist: relayId=baseUrl
ANON_PROXY_TARGETS=""
# Optional push bridge (phase F). Receives POST {"token":"<provider token>"}
# when a queue gets traffic; body has no queue id, sender or content. Point it
# at a UnifiedPush/FCM/APNs adapter. Empty = no push delivery.
ANON_PUSH_WEBHOOK_URL=""

# Bots (docs/bots-roadmap.md)
# ───────────────────────────────────────────────────────────────────────────
# Feature flag. `false` removes the Bots UI, bot deep links and P2P routing into
# bot runtimes; the app then behaves as if bots never existed.
VITE_NOVA_BOTS="true"
# Mini App origin allowlist (Phase B7). CSP `frame-src` is document-wide, so
# Mini Apps live under operator-controlled hosts, one path per bot. Comma-
# separated, https by default. Empty = every remote Mini App is refused.
#   Mini Apps:  https://mess.cvr.name/mini-apps/echo/
#   (origin is https://mess.cvr.name — the app's landing host. Override with a
#   host you control, or set an empty value to deny every remote Mini App.)
VITE_MINI_APP_ORIGINS="https://mess.cvr.name"
# The Tauri shell reads the SAME list as space-separated CSP sources. Before
# `tauri build` / `tauri dev`, exports normally do not carry over — set it in
# the same shell (PowerShell):
#   $env:MINI_APP_ORIGINS = (($env:VITE_MINI_APP_ORIGINS -split ',') |
#       ForEach-Object { $_.Trim().TrimEnd('/') } |
#       Where-Object { $_ -match '^https?://[^/@?#]+$' }) -join ' '
# Empty = desktop/mobile frame-src stays `'self' blob:` (no remote Mini Apps).
