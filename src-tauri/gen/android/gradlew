APP_HOME=$0

# Use $0 to determine the script location
case `$uname` in
    *CYGWIN*) APP_HOME=`cygpath --windows --dir "$APP_HOME"`;;
    *MINGW*) APP_HOME=`cygpath --windows --dir "$APP_HOME"`;;
esac

APP_HOME="$(cd "${APP_HOME:-./}" && pwd)"

APP_NAME=Gradle
DEFAULT_JVM_OPTS=""

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

# Support pipelines
if $cygwin || $msys || $mingw ; then
    APP_HOME=$(cygpath --path --mixed "$APP_HOME")
    CLASSPATH=$(cygpath --path --mixed "$CLASSPATH")
    JAVACMD=$(cygpath --unix "$JAVACMD")
fi

# Attempt to set JAVA_HOME
if [ -z "$JAVA_HOME" ] ; then
    JAVA_EXE=which java 2>/dev/null || die "java not found"
    JAVA_HOME=$(dirname "$JAVA_EXE")/..
fi

# For Cygwin or MinGW, switch to Windows paths.
if $cygwin || $msys || $mingw ; then
    JAVA_HOME=$(cygpath --path --windows "$JAVA_HOME")
    CLASSPATH=$(cygpath --path --windows "$CLASSPATH")
    JAVACMD=$(cygpath --unix "$JAVACMD")
fi

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS="-Xmx64m"

# Collect all arguments for the java command
set -- \
    "-Dorg.gradle.appname=$APP_NAME" \
    -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

exec "$JAVACMD" "$@"
