# Site Gateway — widget chat backend
# Copy to .env and fill in values. Never commit real secrets.

PORT=8081
NODE_ENV=development

# Set to 1 only when a trusted reverse proxy (nginx/Caddy) sits in front.
# Without it every request appears to come from the proxy IP, so all per-IP
# rate limits share one bucket.
# TRUST_PROXY="1"

# Ed25519 signing seed for OAuth id_tokens, base64url or hex (32 bytes).
# Required in production: without it a new key is generated on every boot and
# previously issued id_tokens stop verifying.
# OAUTH_SIGNING_KEY="<base64url-32-bytes>"

# Owner authentication (Bearer token). Preferred: one token per owner user,
# "token1:user1,token2:user2". Each token only grants access to that user's sites.
OWNER_TOKENS="<token>:<user_id>"

# Legacy single-owner token (dev/CI only). Maps to SITE_OWNER_USER_ID.
# SITE_OWNER_TOKEN="<change-me>"
# SITE_OWNER_USER_ID="u1"

# CORS origins allowed to call the gateway from a browser (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:1420,https://mess.cvr.name"

# Data directory (default: ./data)
DATA_DIR="./data"

# Proof-of-work difficulty for guest session creation (1-24, default 16)
POW_DIFFICULTY="16"

# Message retention for undelivered messages in days (default 30)
MESSAGE_RETENTION_DAYS="30"

# Max message size in bytes (default 4096)
MAX_MESSAGE_BYTES="4096"
