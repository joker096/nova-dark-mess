# ============================================================================
# Mess&Anger (Nova Dark Messenger) — environment template
# Copy this to `.env` and fill in fresh values. `.env` is gitignored.
# Never commit real values. For CI, use GitHub Actions Secrets instead.
# ============================================================================

# Android signing (scripts/deploy-android.ps1)
# Path to the keystore (file itself is gitignored: *.jks)
KEYSTORE_PATH="<absolute/path/to/messandanger-keystore.jks>"
# Generate a fresh random password (the old one leaked in plaintext)
KEYSTORE_PASSWORD="<generate_a_new_random_password>"
# Key alias inside the keystore
KEY_ALIAS="messandanger"
# Generate a fresh random password (the old one leaked in plaintext)
KEY_PASSWORD="<generate_a_new_random_password>"

# PaymentO (store: "Mess&Anger user")
# Browser widget (landing/paymento.js) uses the public API key/URL.
# Server (server.js) uses PAYMENTO_SECRET for HMAC-SHA256 signature check.
PAYMENTO_API_URL="https://api.paymento.io"
# Public (front-side) key — shown in the browser widget
PAYMENTO_API_KEY="<paymento_public_api_key>"
# Secret (server-side) — never sent to the browser
PAYMENTO_SECRET_KEY="<paymento_secret_api_key>"
# Shared HMAC secret for the IPN endpoint (store settings "Mess&Anger user")
PAYMENTO_SECRET="<paymento_ipn_hmac_secret>"
# Optional: override the verify endpoint
PAYMENTO_VERIFY_URL=""

# Cloudflare (optional — only if deploying via CF Pages/Workers)
CLOUDFLARE_ACCOUNT_ID="<cloudflare_account_id>"
CLOUDFLARE_API_TOKEN="<cloudflare_scoped_api_token>"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (optional — for signaling relay + profiles)
# Get these from your Supabase project settings → API
VITE_SUPABASE_URL="https://<your-project>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-anon-key>"

# ───────────────────────────────────────────────────────────────────────────
# PaymentO (server-side IPN — see server.js)
# ───────────────────────────────────────────────────────────────────────────
# Shared secret from the PaymentO store settings ("Mess&Anger user" → IPN).
# Used to verify the HMAC-SHA256 signature on every IPN callback.
# Leave empty in dev mode — unsigned IPN will be accepted and logged.
PAYMENTO_SECRET=""
# Optional: override the PaymentO verify endpoint (default: https://api.paymento.io/v2/verify)
PAYMENTO_VERIFY_URL=""
# Where to persist IPN receipts (one JSON per payment). Default: ./receipts
RECEIPTS_DIR=""
# Port for `node server.js` (default 8080)
PORT="8080"
