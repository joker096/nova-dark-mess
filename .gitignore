node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# open-mem: Auto-generated folder context files.
# Uncomment to exclude from version control (recommended for large projects):
# **/AGENTS.md

# Signing keystores — never commit
*.jks
*.keystore

# PaymentO IPN receipts (server.js) — local audit ledger, never commit
receipts/

# Anonymous abuse reports (server.js) — hash-only, but still server state
anon-reports/

# Auto-downloaded gitleaks binary (scripts/check-secrets.js)
tools/gitleaks/

# open-mem local memory database (large, machine-local)
.open-mem/*.db
.open-mem/*.db-shm
.open-mem/*.db-wal

# e2e run artifacts (regenerated on every run)
.e2e/artifacts/
.e2e/cache/
.e2e/report.json
.e2e/bugbash/**/artifacts/
.e2e/bugbash/**/report.json
.andromity/
